// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "idle_inhibitor",
        "custom/dnd",
        "pulseaudio",
        "network",
        "backlight",
        "power-profiles-daemon",
        "bluetooth",
        "hyprland/language",
        "battery",
        "tray",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "all-outputs": true,
        "disable-scroll": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        }
    },
    "mpris": {
        "format": "{status_icon}  {dynamic}",
        "dynamic-len": 40,
        "dynamic-order": [
            "artist",
            "title"
        ],
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤",
            "stopped": "󰓛"
        },
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "clock": {
        "interval": 60,
        "format": "󰥔  {:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#f5c842'><b>{}</b></span>",
                "weekdays": "<span color='#f0a6dc'>{}</span>"
            }
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        },
        "tooltip-format-activated": "Idle inhibitor on",
        "tooltip-format-deactivated": "Idle inhibitor off"
    },
    "custom/dnd": {
        "exec": "makoctl mode | grep -q do-not-disturb && echo '󰂛' || echo '󰂚'",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "makoctl mode -t do-not-disturb; pkill -RTMIN+8 waybar",
        "on-click-right": "makoctl restore"
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon}  {volume}%{format_source}",
        "format-bluetooth": "󰂰  {volume}%{format_source}",
        "format-bluetooth-muted": "󰂲{format_source}",
        "format-muted": "󰝟{format_source}",
        "format-source": "",
        "format-source-muted": "  󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋎",
            "phone": "󰄜",
            "portable": "󰄜",
            "car": "󰄋",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click-right": "pavucontrol",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "󰤨  {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-linked": "󰈂",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr} via {gwaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click-right": "kitty -e nmtui"
    },
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "󰾅",
            "performance": "󰓅",
            "balanced": "󰾆",
            "power-saver": "󰌪"
        }
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱  {num_connections}",
        "format-connected-battery": "󰂱  {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click-right": "kitty -e bluetui"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ar": "AR",
        "tooltip-format": "{long}"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{timeTo}\n{power:.1f} W"
    },
    "tray": {
        "spacing": 10,
        "icon-size": 16
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/wofi/powermenu.sh"
    }
}
