# ~/.config/mako/config
# Palette sampled from the Spamton wallpaper (see hypr/colors.lua)

# General
max-history=20
sort=-time

# Behaviour
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

# Layout
anchor=top-right
margin=12
padding=14
width=360
height=150
layer=overlay
max-visible=5

# Style
font=JetBrainsMono Nerd Font 11
border-size=2
border-radius=12
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
text-alignment=left

# Timeouts
default-timeout=5000
ignore-timeout=0

# Colors
background-color=#161723e6
text-color=#f0f2d6
border-color=#f0a6dc
progress-color=over #481f40

[urgency=low]
border-color=#92abba
text-color=#92abba
default-timeout=2000

[urgency=normal]
border-color=#f0a6dc
default-timeout=5000

[urgency=high]
background-color=#2a0f14e6
border-color=#e8322a
text-color=#f0f2d6
default-timeout=0

[category=mpd]
border-color=#74d8e6
default-timeout=2000
group-by=category

[app-name=Spotify]
border-color=#f5c842
default-timeout=3000

# Toggled from the bell in waybar: makoctl mode -t do-not-disturb
[mode=do-not-disturb]
invisible=1
